import Mathlib

namespace Erdos708.G3

-- Проверяемые базовые свойства делимости.
-- Они не заменяют основную теорему данного раздела.
theorem dvd_mul_right (d a b : ℕ) (h : d ∣ a) : d ∣ a * b := by
  rcases h with ⟨k, hk⟩
  refine ⟨k * b, ?_⟩
  calc
    a * b = (d * k) * b := by rw [hk]
    _ = d * (k * b) := by rw [mul_assoc]

end Erdos708.G3
